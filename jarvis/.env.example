# Zkopíruj jako .env a vyplň. .env nikdy necommituj.

# Smyčky bez obsluhy (cron / Plánovač úloh)
# Token vygeneruj příkazem `claude setup-token` — cron nemá přístup
# ke klíčence ani k interaktivnímu přihlášení.
CLAUDE_CODE_OAUTH_TOKEN=

# Zápis nákladů běhu do tabulky runs (scripts/run-loop.sh).
# Supabase → projekt jarvis → Project Settings → API. Service role klíč
# obchází RLS: jen do .env na nonstop PC, nikam jinam.
SUPABASE_URL=https://corwufqibjbdvsqhqphh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Až bude telefon (fáze 3)
TELNYX_API_KEY=
ELEVENLABS_API_KEY=
JARVIS_PHONE_NUMBER=

# Čísla, na která Jarvis smí volat (jen majitelé)
RADEK_PHONE=
BOHUSLAV_PHONE=
